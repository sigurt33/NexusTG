[Unit]
Description=NexusTG — ingestion + classifier + bot (daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexustg
WorkingDirectory=/home/nexustg/NexusTG
# uv ставится в ~/.local/bin (см. DEPLOY.md). PYTHONIOENCODING — против падений print с кириллицей.
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/nexustg/.local/bin/uv run python -m app.cli run
Restart=on-failure
RestartSec=10
# Перезапуск не чаще 5 раз за 5 минут — иначе при отозванной сессии будет долбить Telegram
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
